# Judicial Yuan Open Data Platform Credentials
# Register at: https://opendata.judicial.gov.tw/

# Your account (saved in file)
JUDICIAL_ACCOUNT=your_account_here

# Password will be prompted during execution (not saved for security)

# Secret key for hashing defendant names (HMAC-SHA256).
# Generate once: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit the real value; changing it invalidates all existing name hashes.
NAME_HASH_KEY=your_random_hex_key_here
